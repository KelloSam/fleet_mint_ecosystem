<div class="mb-6 flex items-center justify-between">
  <div>
    <h1 class="text-2xl font-bold text-gray-800">Schedules</h1>
    <p class="text-sm text-gray-500 mt-1">
      Real departures, fares, and seat availability by operator
    </p>
  </div>
  <%= if @current_user.role in ["platform_admin", "tenant_admin", "manager"] do %>
    <.link href={~p"/schedules/new"}>
      <.button class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg text-sm font-medium">
        + Add Schedule
      </.button>
    </.link>
  <% end %>
</div>

<div class="mb-4 flex gap-2">
  <%= for {label, val} <- [{"All", ""}, {"Active", "active"}, {"Cancelled", "cancelled"}, {"Suspended", "suspended"}] do %>
    <.link
      href={if val == "", do: ~p"/schedules", else: ~p"/schedules?status=#{val}"}
      class={[
        "px-3 py-1.5 rounded-full text-xs font-medium border",
        if(@filter_status == val,
          do: "bg-blue-600 text-white border-blue-600",
          else: "bg-white text-gray-600 border-gray-300 hover:border-blue-400"
        )
      ]}
    >
      <%= label %>
    </.link>
  <% end %>
</div>

<div class="bg-white rounded-lg shadow overflow-hidden">
  <%= if @paged.entries == [] do %>
    <div class="text-center py-16 text-gray-500">
      <svg
        class="mx-auto h-12 w-12 text-gray-300 mb-4"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="1.5"
          d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
        />
      </svg>
      <p class="font-medium">No schedules found</p>
      <p class="text-sm mt-1">Add a schedule to start running trips on a route.</p>
    </div>
  <% else %>
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
            Code
          </th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
            Route
          </th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
            Operator
          </th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
            Departure
          </th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
            Fare
          </th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
            Seats
          </th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
            Status
          </th>
          <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">
            Actions
          </th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-100">
        <%= for schedule <- @paged.entries do %>
          <tr
            class="hover:bg-gray-50 cursor-pointer"
            phx-click={JS.navigate(~p"/schedules/#{schedule}")}
          >
            <td class="px-6 py-4 text-sm font-mono font-semibold text-gray-900">
              <%= schedule.schedule_code %>
            </td>
            <td class="px-6 py-4 text-sm text-gray-700">
              <%= if schedule.route do %>
                <%= schedule.route.start_location %>
                <span class="mx-1 text-gray-400">→</span>
                <%= schedule.route.end_location %>
              <% else %>
                —
              <% end %>
            </td>
            <td class="px-6 py-4 text-sm text-gray-700">
              <%= schedule.operator && schedule.operator.name %>
            </td>
            <td class="px-6 py-4 text-sm text-gray-700 font-mono">
              <%= schedule.departure_time |> Time.to_string() |> String.slice(0, 5) %>
            </td>
            <td class="px-6 py-4 text-sm font-medium text-gray-900">ZMW <%= schedule.fare %></td>
            <td class="px-6 py-4 text-sm text-gray-700"><%= schedule.available_seats %></td>
            <td class="px-6 py-4">
              <span class={[
                "inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium",
                case schedule.status do
                  "active" -> "bg-emerald-100 text-emerald-700"
                  "cancelled" -> "bg-red-100 text-red-700"
                  _ -> "bg-gray-100 text-gray-600"
                end
              ]}>
                <%= String.capitalize(schedule.status) %>
              </span>
            </td>
            <td class="px-6 py-4 text-right text-sm">
              <%= if @current_user.role in ["platform_admin", "tenant_admin", "manager"] do %>
                <.link
                  navigate={~p"/schedules/#{schedule}/edit"}
                  class="text-blue-600 hover:text-blue-800 font-medium mr-4"
                >
                  Edit
                </.link>
                <.link
                  href={~p"/schedules/#{schedule}"}
                  method="delete"
                  data-confirm={"Delete schedule \"#{schedule.schedule_code}\"?"}
                  class="text-red-500 hover:text-red-700 font-medium"
                >
                  Delete
                </.link>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <div class="px-6 py-3 bg-gray-50 border-t text-xs text-gray-500">
      <%= @paged.total %> schedule<%= if @paged.total != 1, do: "s", else: "" %> total
    </div>
    <.pagination
      page={@paged.page}
      total_pages={@paged.total_pages}
      path={
        &if @filter_status == "",
          do: ~p"/schedules?page=#{&1}",
          else: ~p"/schedules?page=#{&1}&status=#{@filter_status}"
      }
    />
  <% end %>
</div>
