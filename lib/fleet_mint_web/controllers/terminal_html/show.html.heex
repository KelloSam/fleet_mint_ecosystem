<div class="mb-6 flex items-start justify-between">
  <div>
    <.link
      navigate={~p"/terminals"}
      class="text-sm text-gray-500 hover:text-gray-700 flex items-center gap-1"
    >
      <.icon name="hero-arrow-left-solid" class="h-3 w-3" /> Terminals
    </.link>
    <h1 class="text-2xl font-bold text-gray-800 mt-2"><%= @terminal.name %></h1>
  </div>
  <div class="flex gap-3">
    <.link navigate={~p"/terminals/#{@terminal}/edit"}>
      <.button class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg text-sm">
        Edit Terminal
      </.button>
    </.link>
    <.link
      href={~p"/terminals/#{@terminal}"}
      method="delete"
      data-confirm={"Remove terminal #{@terminal.name}?"}
    >
      <.button class="bg-red-50 hover:bg-red-100 text-red-600 border border-red-200 px-4 py-2 rounded-lg text-sm">
        Delete
      </.button>
    </.link>
  </div>
</div>

<div class="bg-white rounded-lg shadow p-6 max-w-xl">
  <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wider mb-4">
    Terminal Details
  </h2>
  <dl class="divide-y divide-gray-100">
    <div class="py-3 flex justify-between text-sm">
      <dt class="text-gray-500 font-medium">Name</dt>
      <dd class="text-gray-900 font-semibold"><%= @terminal.name %></dd>
    </div>
    <div class="py-3 flex justify-between text-sm">
      <dt class="text-gray-500 font-medium">Branch</dt>
      <dd class="text-gray-900">
        <.link
          navigate={~p"/branches/#{@terminal.branch}"}
          class="text-blue-600 hover:text-blue-800"
        >
          <%= @terminal.branch.name %>
        </.link>
      </dd>
    </div>
    <div class="py-3 flex justify-between text-sm">
      <dt class="text-gray-500 font-medium">Address</dt>
      <dd class="text-gray-900"><%= @terminal.address || "—" %></dd>
    </div>
  </dl>
</div>
